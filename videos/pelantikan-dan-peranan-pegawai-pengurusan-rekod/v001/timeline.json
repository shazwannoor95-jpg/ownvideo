    {
      "id": "s07",
      "start_seconds": 244.26666666666668,
      "end_seconds": 280.8666666666667,
      "start_frame": 7328,
      "duration_frames": 1098,
      "duration_seconds": 36.6,
      "narration_offset_seconds": 0.25,
      "narration_text": "Bagi rekod terbuka, Pegawai Rekod Jabatan, atau P R J, menyelia pengurusan fail di Jabatan, Bahagian atau Unit. Pegawai yang dinyatakan ialah Gred sembilan ke atas. Jika tiada, pegawai Gred lima ke atas boleh dilantik. Pembantu Tadbir Rekod Jabatan, atau P T R J, pula mengurus pengurusan fail dan melibatkan pegawai Gred satu ke atas. Kedua-dua peranan merujuk Panduan Pengurusan Rekod Sektor Awam, Arkib Negara Malaysia, sebagai sumber lantikan. Pihak yang melantik kedua-duanya ialah Arkib Negara Malaysia.",
      "narration_sha256": "6766faa31225efd3f939d4ab7e741b092512ab6d3f186750458373605f8d3c96",
