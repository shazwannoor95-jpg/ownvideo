    {
      "id": "s08",
      "start_seconds": 280.8666666666667,
      "end_seconds": 330.06666666666666,
      "start_frame": 8426,
      "duration_frames": 1476,
      "duration_seconds": 49.2,
      "narration_offset_seconds": 0.25,
      "narration_text": "Akhir sekali, sumber menyenaraikan pembatalan lantikan apabila berlaku perubahan jawatan atau penempatan, bersara, berhenti atau tamat perkhidmatan. Jadual pengurusan rekod turut menyenaraikan pelanggaran peraturan atau tatatertib, serta tidak melaksanakan tugas. Bagi Pegawai Pengelas, perubahan nama juga disenaraikan, bersama penyerahan kembali sijil perakuan kepada B A R U atau U A C. Bagi Pegawai Pengelas Semula dan penerima pewakilan, sumber menyebut pertukaran jabatan atau meninggalkan perkhidmatan. Sebagai rumusan, kenal pasti peranan, kuasa dan borang yang berkaitan supaya urusan pelantikan dapat difahami dengan jelas.",
      "narration_sha256": "821cfffc33a0c51ca9219c1887f3933d57ba31dc91636cc91d8476f783a27b72",
